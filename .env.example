# Supabase 프로젝트(서울 ap-northeast-2) → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 서버 전용. 지금 코드는 쓰지 않는다(사진 단계에서 서명 URL용). 절대 NEXT_PUBLIC_ 붙이지 않는다.
# SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SITE_URL=https://joyeondang.cmdspace.work
# 정식으로 문을 열 때만 1 (그 전에는 검색엔진 색인 막음)
NEXT_PUBLIC_LAUNCHED=0

# 실제 집 걷기(명단 손님 전용). 서버 전용, 저장소·빌드 결과물에는 넣지 않는다.
# 집 세계 파일(house-world.json)을 gzip -9c 파일 | base64 로 바꿔 그 값을 Vercel 환경 변수에만 넣는다.
# HOUSE_WORLD_GZ=
# 이 맥에서만 로그인 없이 실제 집을 미리 걷기(Vercel에서는 켜지지 않음)
# JY_LOCAL_PREVIEW=1

# 가족 방 이름표(명단 손님 전용, 서버 전용). 실명이 들어가므로 Vercel 환경 변수에만 넣는다. 형식만:
# FAMILY_ROOMS_JSON=[{"slug":"study","owner":"가족 이름","title":"가족 이름의 방","line":"한 줄 소개"}]

# 함께 걷기(작은 게임 서버, Cloudflare Durable Objects). 서버 전용.
# GAME_SERVER_URL=wss://<게임 서버 주소>
# 토큰 서명 키: game-server의 비밀값과 같은 값. openssl rand -base64 32 로 만든다.
# GAME_TOKEN_SECRET=
