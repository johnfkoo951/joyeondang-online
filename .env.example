# Supabase 프로젝트(서울 ap-northeast-2) → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 서버 전용. 쪽지 사진 받기와 사진 캐릭터 만들기가 쓴다(없으면 쪽지는 글만 받고, 캐릭터 만들기는 「준비 중」).
# 절대 NEXT_PUBLIC_ 붙이지 않는다.
# SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SITE_URL=https://joyeondang.cmdspace.work
# 정식으로 문을 열 때만 1 (그 전에는 검색엔진 색인 막음)
NEXT_PUBLIC_LAUNCHED=0

# 실제 집 걷기(명단 손님 전용). 서버 전용, 저장소·빌드 결과물에는 넣지 않는다.
# 집 세계 파일(house-world.json)을 gzip -9c 파일 | base64 로 바꿔 그 값을 Vercel 환경 변수에만 넣는다.
# HOUSE_WORLD_GZ=
# 이 맥에서만 로그인 없이 실제 집을 미리 걷기(Vercel에서는 켜지지 않음)
# JY_LOCAL_PREVIEW=1
# 실제 집 걷기의 꾸밈. plain이면 행사 꾸밈 없이, 없거나 다른 값이면 지금 행사 꾸밈.
# WALK_THEME=plain
# 부엌 사진 갤러리(실제 집 걷기). 1일 때만 액자를 건다(없거나 다른 값이면 걸지 않는다, 채우지 않은 액자는 「곧 전시해요」).
# 전시 목록과 그림은 비공개 버킷 gallery(supabase/migrations/0023_gallery.sql)에 있고 SUPABASE_SECRET_KEY로만 읽는다.
# 버킷을 만들고 승인함에서 미리 채운 뒤에 켠다.
# KITCHEN_GALLERY=1
# 이 맥에서만(JY_LOCAL_PREVIEW) 갤러리 미리보기: manifest.json과 그림이 든 폴더(버킷과 같은 모양)
# GALLERY_PREVIEW_DIR=
# 실측 1층 시험 지도(관리자 전용, /api/house-shell). 서버 전용, 저장소·빌드 결과물에는 넣지 않는다.
# 도면 쪽 내보내기 도구가 만드는 실측 껍데기 JSON을 gzip한 뒤 base64 한 줄로. 없으면 관리자에게도 지도 고르기에서 평소 집이 보인다.
# HOUSE_SHELL_GZ=
# 실측 지도를 여는 계정(로그인 id, 쉼표로). 목록에 있는 관리자만 연다. 비면 아무도 못 연다(이 맥 미리보기 제외)
# HOUSE_SHELL_USERS=
# 이 맥에서만(JY_LOCAL_PREVIEW) 실측 껍데기 파일을 바로 읽기(JSON 또는 gzip, 저장소 밖 경로). 다시 내보내면 서버를 다시 띄우지 않아도 된다
# HOUSE_SHELL_FILE=

# 가족 방 이름표(명단 손님 전용, 서버 전용). 실명이 들어가므로 Vercel 환경 변수에만 넣는다. 형식만:
# FAMILY_ROOMS_JSON=[{"slug":"study","owner":"가족 이름","title":"가족 이름의 방","line":"한 줄 소개"}]

# 집 안팎을 오가는 반려동물(서버 전용). 이름이 들어가므로 Vercel 환경 변수에만 넣는다. 없으면 반려동물 없이 걷는다.
# 모형은 누구에게나 보이고(구경하는 집에도), 이름표는 명단 손님 이상에게만 간다. walk·rest는 같은 사이트의 .glb 경로(public/ 아래),
# rest는 빼면 걷는 자세로 쉰다. scale은 크기 배율(0.3~2, 빼면 1 = 몸길이가 사람 캐릭터 키의 0.45배. 실물에 가깝게는 0.6쯤).
# rests는 더 있는 쉬는 자세(loaf 식빵 자세, groom 털 고르기, lie 눕기, 빼도 된다). 혼자 쉴 때 주사위로 고르고, 못 받으면 앉아서 쉰다.
# friends는 자주 찾아가는 사람: 로그인 사용자 id와 무게 w(1~3, 클수록 자주). 함께 걷기로 같은 집에 있으면 곁에 가서 앉아 운다.
# 화면에는 id 대신 그 사람이 걷기 화면에서 보이는 이름만 명단 손님 이상에게 간다(이름은 SUPABASE_SECRET_KEY로 읽는다). 형식만:
# PET_JSON={"name":"이름","walk":"/pet-walk.glb","rest":"/pet-rest.glb","rests":{"loaf":"/pet-loaf.glb","groom":"/pet-groom.glb","lie":"/pet-lie.glb"},"friends":[{"user":"<사용자 id>","w":3}]}
# 이 맥의 로컬 미리보기(JY_LOCAL_PREVIEW)에서만: DB 없이 친구 이름을 지어낸 이름으로(가짜 손님으로 찾아가기를 확인할 때)
# PET_PREVIEW_NAMES={"<사용자 id>":"지어낸 이름"}

# 「누구의 문장일까」 카드(명단 손님 전용, 서버 전용). 실명과 실제 문장이 들어가므로 Vercel 환경 변수에만 넣는다.
# 없으면 놀이는 지어낸 종이 인형 연습판으로 논다. 사람 2~8명: id(영문 소문자·숫자·-, 16자까지), name(20자까지),
# icon(pen piano brush ball book leaf star heart music spark 중 하나), color(roof pine lamp sky oak clay plum moss 중 하나),
# intro(140자까지). 문장: who(사람 id), text(140자까지). 틀린 항목은 빼고 쓴다. 아래는 지어낸 예시(한 줄 JSON):
# WHO_DECK_JSON={"people":[{"id":"cup","name":"컵 인형","icon":"heart","color":"clay","intro":"따뜻한 차를 좋아해요."},{"id":"kite","name":"연 인형","icon":"leaf","color":"sky","intro":"바람 부는 날을 기다려요."}],"lines":[{"who":"cup","text":"천천히 마셔도 괜찮아요."},{"who":"kite","text":"줄을 놓지 않으면 더 높이 가요."}]}

# 함께 걷기(작은 게임 서버, Cloudflare Durable Objects). 서버 전용.
# GAME_SERVER_URL=wss://<게임 서버 주소>
# 토큰 서명 키: game-server의 비밀값과 같은 값. openssl rand -base64 32 로 만든다.
# GAME_TOKEN_SECRET=

# 현장 QR 도장을 받는 행사 날(YYYY-MM-DD, 한국 시간). 없거나 형식이 틀리면 코드에 적힌 기본 날짜를 쓴다.
# QR_EVENT_DAY=

# 사진 캐릭터 만들기(SUPABASE_SECRET_KEY가 있어야 열린다). 서버 전용.
# 0이면 만들기를 잠근다(화면에 「준비 중」). 없으면 열려 있다.
# AVATAR_ENABLED=0
# 모두 합친 하루 만들기 상한(0 이상의 숫자). 없거나 이상한 값이면 코드의 기본값을 쓴다.
# AVATAR_DAILY_CAP_TOTAL=
# 3D 모형을 어디서 만드는지(meshy | trellis). 동의 글·3D 확인·개인정보 화면의 말이 이것을 따르고, 3D 요청 줄에도 적는다
# (일꾼은 제 제공자로 요청한 줄만 잡는다: meshy 일꾼은 meshy로, trellis 일꾼은 trellis로 요청한 줄만). 일꾼이 쓰는 3D 서비스와 같게 둔다.
# 다르면 요청이 그곳의 일꾼을 기다리기만 한다. 없거나 이상한 값이면 meshy(외부로 보낸다고 알리는 쪽).
# AVATAR_MODEL_PROVIDER=meshy
# 1이면 「Meshy에는 받은 그림을 학습에 쓰지 않도록 요청해 두었고」라고 알린다. Meshy에 학습 제외를 요청해 답을 받은 뒤에만 켠다.
# 없으면(기본) 약관대로 「Meshy 약관상 받은 그림이 학습에 쓰일 수 있고」라고 알린다.
# MESHY_TRAINING_OPTOUT=1
# 0이면 사이트의 3D 만들기 단추와 요청 라우트를 쉰다(이미 만든 3D는 그대로 보인다). 돈을 실제로 멈추는 것은 일꾼의 AVATAR_MODELS=0이다
# (DB의 3D 요청 함수는 로그인한 손님이 직접 부를 수 있다. 한도는 DB가 지킨다).
# AVATAR_MODELS=0
