<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>work.cmdspace.joyeondang-model-tunnel</string>
	<!-- 조연당 온라인 3D 모형 일꾼이 그래픽 카드 PC의 3D 서비스에 닿는 SSH 터널(Mac Studio). 늘 열어 두고, 끊기면 launchd가 다시 연다.
	     이 맥의 127.0.0.1:17860 → 그 PC의 127.0.0.1:7860. 그 PC의 방화벽 포트는 열지 않는다(SSH만 쓴다).
	     __SSH__: ssh 절대 경로(보통 /usr/bin/ssh), __GPU_HOST__: ~/.ssh/config에 둔 그 PC의 호스트 이름,
	     __LOG_DIR__: 기록 폴더(예: 저장소의 worker/avatar/logs). 비밀번호 없이 쓰는 키가 있어야 한다(launchd는 묻지 못한다).
	     먼저 `ssh -o BatchMode=yes __GPU_HOST__ exit`가 그냥 끝나는지 본다. 일꾼의 AVATAR_MODEL_URL은 기본값(http://127.0.0.1:17860) 그대로. -->
	<key>ProgramArguments</key>
	<array>
		<string>__SSH__</string>
		<string>-N</string>
		<!-- 묻지 않는다(비밀번호·처음 보는 호스트 키 확인을 기다리며 멈추지 않게) -->
		<string>-o</string>
		<string>BatchMode=yes</string>
		<!-- 포트를 못 열면(17860을 이미 누가 쓰면) 바로 끝낸다: 열리지 않은 터널을 연 줄 알고 붙들고 있지 않게 -->
		<string>-o</string>
		<string>ExitOnForwardFailure=yes</string>
		<!-- 연결이 소리 없이 죽으면(PC가 잠듦, 망이 바뀜) 1분 30초 안에 알아채고 끝낸다. launchd가 다시 연다 -->
		<string>-o</string>
		<string>ServerAliveInterval=30</string>
		<string>-o</string>
		<string>ServerAliveCountMax=3</string>
		<string>-L</string>
		<string>127.0.0.1:17860:127.0.0.1:7860</string>
		<string>__GPU_HOST__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- 그 PC가 꺼져 있으면 ssh가 바로 끝난다. 30초에 한 번만 다시 해 본다 -->
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/model-tunnel.out.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/model-tunnel.err.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
