// 조연당 함께 걷기 서버. Worker 하나가 /connect 요청을 공간(Durable Object)마다 넘긴다.
// 비밀값 GAME_TOKEN_SECRET은 여기 쓰지 않는다: 배포는 `npx wrangler secret put GAME_TOKEN_SECRET`,
// 로컬은 .dev.vars(커밋 안 함). README.md 참고.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joyeondang-game",
  "main": "src/index.ts",
  // 2026-04-07 이후 날짜라 닫기 프레임에 런타임이 알아서 답한다(web_socket_auto_reply_to_close)
  "compatibility_date": "2026-11-01",
  // 로그(observability)는 켜지 않는다: 요청 주소에 출입증이 들어 있어 기록에 남기지 않으려고
  "durable_objects": {
    "bindings": [{ "name": "SPACE", "class_name": "Space" }]
  },
  // SQLite 백엔드 클래스: 무료 요금제에서도 돈다. 이미 배포한 태그는 고치지 말고 새 태그를 더한다.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Space"] }],
  "vars": {
    // 걷기 화면이 열리는 주소(쉼표 목록). 로컬 시험은 .dev.vars에서 덮어쓴다
    "ALLOWED_ORIGINS": "https://joyeondang.cmdspace.work"
  }
}
